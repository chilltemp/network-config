# Copy to bin/.env (gitignored), then: chmod 600 bin/.env
# Same list is loaded for every project; each project's .mcp.json uses only what it needs.
#
# Format: KEY=VALUE, one per line. Values are read LITERALLY (not shell-sourced),
# so paste raw tokens as-is — no quoting or escaping needed even for & $ * % ^.
# Do not wrap values in quotes (quotes would become part of the value). '#' starts
# a comment only at the very start of a line.
READINGORDER_API_KEY_LOCAL=
READINGORDER_API_KEY_DEV=
READINGORDER_API_KEY_PROD=
PAPERLESS_TOKEN=
HEROUI_TOKEN=
